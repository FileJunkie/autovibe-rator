# Bot configuration
BOT_HANDLE=autovibe-rator

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem

# Webhook
GITHUB_WEBHOOK_SECRET=

# Server
PORT=3000

# Logging
# LOG_LEVEL: debug | info | warn | error  (default: info)
# LOG_FORMAT: text (human-readable) | syslog (RFC 5424 <PRI> prefix, for
#   journald/remote syslog forwarding - set this in the systemd unit when
#   running the .deb service)
LOG_LEVEL=info
LOG_FORMAT=text

# Docker
DOCKER_CMD=docker

# Allowed repository OWNERS (GitHub user/org logins), comma-separated.
# REQUIRED - the harness refuses to start without at least one owner, as a
# fail-closed default. The app only works on repos owned by these accounts;
# add more logins to grant more users.
# ALLOWED_OWNERS=filejunkie

# Which webhook author associations may trigger a run, comma-separated.
# Defaults to OWNER,MEMBER,COLLABORATOR (repo collaborators only - drive-by
# commenters have association NONE). Set to ALL to disable the gate.
# ALLOWED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# Note: GITHUB_APP_INSTALLATION_ID is automatically extracted from webhook payload
# No need to set it manually
